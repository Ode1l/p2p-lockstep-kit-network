{
  "name": "p2p-lockstep-kit-network",
  "version": "0.1.4",
  "description": "WebRTC signalling and peer abstractions for the p2p lockstep kit.",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "./dist/network/index.js",
  "types": "./dist/network/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/network/index.d.ts",
      "import": "./dist/network/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "rimraf": "^5.0.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
